---
import Base from '../layouts/Base.astro';
import { getUi } from '../lib/content';

const locale = 'en';
const title = getUi('not_found_title', locale);
const linkText = getUi('not_found_link', locale);
---

<Base locale={locale} currentPath="/404" title="404">
  <div class="container not-found-container">
    <div class="not-found-box">
      <span class="error-code">404</span>
      <h1 class="error-title">{title}</h1>
      <a href="/" class="error-link">← {linkText}</a>
    </div>
  </div>
</Base>

<style>
  .not-found-container {
    padding: 8rem var(--gutter);
  }

  .not-found-box {
    max-width: 50ch;
  }

  .error-code {
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    color: var(--lane-research);
    display: block;
    margin-bottom: 0.5rem;
  }

  .error-title {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.2;
    margin-bottom: 1.5rem;
    font-weight: 400;
  }

  .error-link {
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
