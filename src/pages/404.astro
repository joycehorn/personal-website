---
import Base from '../layouts/Base.astro';
import MiniTimeline from '../components/MiniTimeline.astro';
import { getUi } from '../lib/content';

const locale = 'en';
const title = getUi('not_found_title', locale);
const linkText = getUi('not_found_link', locale);
---

<Base locale={locale} currentPath="/404" title="404 — Not Found">
  <div class="container not-found-container">
    <div class="section-grid">
      <div class="section-label">
        404
      </div>

      <div class="section-content not-found-content">
        <h1 class="error-title">{title}</h1>

        <div class="not-found-timeline">
          <MiniTimeline locale={locale} emptyPlayhead={true} href="/" />
        </div>

        <div class="error-action">
          <a href="/" class="error-link">← {linkText}</a>
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  .not-found-container {
    padding-top: 2rem;
    padding-bottom: 8rem;
  }

  .not-found-content {
    max-width: var(--col-reading);
  }

  .error-title {
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.15;
    margin-bottom: 2rem;
    font-weight: 400;
  }

  .not-found-timeline {
    margin-bottom: 2.5rem;
  }

  .error-action {
    margin-top: 2rem;
  }

  .error-link {
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color var(--transition-fast);
  }

  .error-link:hover {
    color: var(--lane-research);
  }
</style>
