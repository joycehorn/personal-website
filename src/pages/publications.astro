---
import Base from '../layouts/Base.astro';
import PubList from '../components/PubList.astro';
import { getUi } from '../lib/content';

const locale = 'en';
const navPubs = getUi('nav_publications', locale);
---

<Base locale={locale} currentPath="/publications" title={navPubs}>
  <div class="container pub-container">
    <div class="section-grid">
      <div class="section-label">
        {navPubs}
      </div>

      <div class="section-content">
        <header class="pub-header-block">
          <h1 class="pub-page-title">{navPubs}</h1>
        </header>

        <PubList locale={locale} />
      </div>
    </div>
  </div>
</Base>

<style>
  .pub-container {
    padding-top: 1rem;
    padding-bottom: 6rem;
  }

  .pub-header-block {
    margin-bottom: 2.5rem;
  }

  .pub-page-title {
    font-size: clamp(2.5rem, 5vw, 3.75rem);
    line-height: 1.1;
    font-weight: 400;
    color: var(--ink);
  }
</style>
