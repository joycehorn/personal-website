---
import type { Locale, Project, Publication } from '../lib/types';
import { loadContent, t, getUi } from '../lib/content';
import Chip from './Chip.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = loadContent();

const featuredProjects = content.projects.filter((p) => p.featured);
const otherProjects = content.projects.filter((p) => !p.featured);

const pubsMap = new Map<string, Publication>();
for (const pub of content.publications) {
  pubsMap.set(pub.id, pub);
}

const pubsHref = locale === 'pt' ? '/pt/publicacoes' : '/publications';
const relatedPubsLabel = getUi('related_pubs', locale);
const sectionLabel = locale === 'pt' ? 'Projetos selecionados' : 'Selected projects';
---

<section id="projects" class="projects-section" aria-labelledby="projects-label">
  <div class="container">
    <div class="section-grid">
      <div class="section-label" id="projects-label">
        {sectionLabel}
      </div>

      <div class="section-content">
        <div class="featured-list">
          {featuredProjects.map((project, idx) => {
            const role = project.role ? t(project.role, locale) : '';
            const related = (project.publications || [])
              .map((id) => pubsMap.get(id))
              .filter((p): p is Publication => Boolean(p));

            return (
              <article class="project-entry" data-index={idx}>
                <header class="project-header">
                  <div class="project-meta">
                    <span class="project-period">{project.period}</span>
                    <span class="meta-sep">/</span>
                    <span class="project-context">{project.context}</span>
                    {role && (
                      <>
                        <span class="meta-sep">/</span>
                        <span class="project-role">{role}</span>
                      </>
                    )}
                  </div>
                  <h3 class="project-title">{t(project.title, locale)}</h3>
                </header>

                <p class="project-summary">{t(project.summary, locale)}</p>

                <div class="project-footer">
                  <div class="project-chips">
                    {project.tags.map((tag) => (
                      <Chip tag={tag} locale={locale} />
                    ))}
                  </div>

                  {related.length > 0 && (
                    <div class="project-related">
                      <span class="related-label">{relatedPubsLabel}:</span>
                      <ul class="related-list">
                        {related.map((pub) => {
                          const pubShort = pub.venue.split('–')[0].split('@')[0].trim();
                          return (
                            <li>
                              <a href={`${pubsHref}#${pub.id}`} class="related-link" title={pub.title}>
                                {pubShort} ({pub.year})
                              </a>
                            </li>
                          );
                        })}
                      </ul>
                    </div>
                  )}
                </div>
              </article>
            );
          })}
        </div>

        {otherProjects.length > 0 && (
          <div class="other-projects">
            {otherProjects.map((project) => {
              const related = (project.publications || [])
                .map((id) => pubsMap.get(id))
                .filter((p): p is Publication => Boolean(p));

              return (
                <article class="project-entry project-quiet">
                  <div class="project-meta">
                    <span class="project-period">{project.period}</span>
                    <span class="meta-sep">/</span>
                    <span class="project-context">{project.context}</span>
                  </div>
                  <h4 class="project-title project-quiet-title">{t(project.title, locale)}</h4>
                  <p class="project-summary project-quiet-summary">{t(project.summary, locale)}</p>
                  
                  <div class="project-footer">
                    <div class="project-chips">
                      {project.tags.map((tag) => (
                        <Chip tag={tag} locale={locale} />
                      ))}
                    </div>

                    {related.length > 0 && (
                      <div class="project-related">
                        <span class="related-label">{relatedPubsLabel}:</span>
                        <ul class="related-list">
                          {related.map((pub) => {
                            const pubShort = pub.venue.split('–')[0].split('@')[0].trim();
                            return (
                              <li>
                                <a href={`${pubsHref}#${pub.id}`} class="related-link" title={pub.title}>
                                  {pubShort} ({pub.year})
                                </a>
                              </li>
                            );
                          })}
                        </ul>
                      </div>
                    )}
                  </div>
                </article>
              );
            })}
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .featured-list {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .project-entry {
    padding-bottom: 3.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .project-meta {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    color: var(--muted);
    margin-bottom: 0.75rem;
  }

  .project-period {
    color: var(--ink);
    letter-spacing: 0.02em;
  }

  .meta-sep {
    color: var(--rule);
  }

  .project-role {
    color: var(--lane-research);
  }

  .project-title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2vw, 1.85rem);
    font-weight: 400;
    line-height: 1.25;
    color: var(--ink);
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }

  .project-summary {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.65;
    color: var(--ink);
    max-width: var(--col-reading);
    margin-bottom: 1.5rem;
  }

  .project-footer {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .project-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .project-related {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
  }

  .related-label {
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .related-list {
    list-style: none;
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    margin: 0;
    padding: 0;
  }

  .related-link {
    color: var(--muted);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 3px;
    transition: color var(--transition-fast), text-decoration-color var(--transition-fast);
  }

  .related-link:hover {
    color: var(--ink);
    text-decoration-color: var(--ink);
  }

  /* Quiet non-featured row */
  .other-projects {
    margin-top: 3.5rem;
  }

  .project-quiet {
    border-bottom: none;
    padding-bottom: 0;
  }

  .project-quiet-title {
    font-size: 1.25rem;
    color: var(--muted);
  }

  .project-quiet-summary {
    color: var(--muted);
    font-size: 0.98rem;
  }
</style>
