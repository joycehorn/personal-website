---
import type { Locale, Project, Publication } from '../lib/types';
import { loadContent, t, getUi } from '../lib/content';
import Chip from './Chip.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = loadContent();

const featuredProjects = content.projects.filter((p) => p.featured);
const otherProjects = content.projects.filter((p) => !p.featured);

const pubsMap = new Map<string, Publication>();
for (const pub of content.publications) {
  pubsMap.set(pub.id, pub);
}

const pubsHref = locale === 'pt' ? '/pt/publicacoes' : '/publications';
const relatedPubsLabel = getUi('related_pubs', locale);
const sectionLabel = locale === 'pt' ? 'Projetos selecionados' : 'Selected projects';
---

<section id="projects" class="projects-section" aria-labelledby="projects-label">
  <div class="container">
    <div class="section-grid">
      <h2 class="section-label" id="projects-label">
        {sectionLabel}
      </h2>

      <div class="section-content">
        <div class="featured-list">
          {featuredProjects.map((project, idx) => {
            const role = project.role ? t(project.role, locale) : '';
            const related = (project.publications || [])
              .map((id) => pubsMap.get(id))
              .filter((p): p is Publication => Boolean(p));

            return (
              <article class="project-entry" data-index={idx}>
                <header class="project-header">
                  <div class="project-meta">
                    <span class="project-period">{project.period}</span>
                    <span class="meta-sep">/</span>
                    <span class="project-context">{project.context}</span>
                    {role && (
                      <>
                        <span class="meta-sep">/</span>
                        <span class="project-role">{role}</span>
                      </>
                    )}
                  </div>
                  <h3 class="project-title">{t(project.title, locale)}</h3>
                </header>

                <p class="project-summary">{t(project.summary, locale)}</p>

                <div class="project-footer">
                  <div class="project-chips">
                    {project.tags.map((tag) => (
                      <Chip tag={tag} locale={locale} />
                    ))}
                  </div>

                  {related.length > 0 && (
                    <div class="project-related">
                      <span class="related-label">{relatedPubsLabel}:</span>
                      <ul class="related-list">
                        {related.map((pub) => {
                          const pubShort = pub.venue.split('–')[0].split('@')[0].trim();
                          return (
                            <li>
                              <a href={`${pubsHref}#${pub.id}`} class="related-link" title={pub.title}>
                                {pubShort} ({pub.year})
                              </a>
                            </li>
                          );
                        })}
                      </ul>
                    </div>
                  )}
                </div>
              </article>
            );
          })}
        </div>

        {otherProjects.length > 0 && (
          <div class="other-projects">
            {otherProjects.map((project) => {
              const related = (project.publications || [])
                .map((id) => pubsMap.get(id))
                .filter((p): p is Publication => Boolean(p));
              const isMusic = project.id === 'music';

              return (
                <article class={`project-entry project-quiet ${isMusic ? 'project-music' : ''}`}>
                  <div class={isMusic ? 'music-row-wrap' : ''}>
                    <div class="project-info">
                      <div class="project-meta">
                        <span class="project-period">{project.period}</span>
                        <span class="meta-sep">/</span>
                        <span class="project-context">{project.context}</span>
                      </div>
                      <h3 class="project-title project-quiet-title">{t(project.title, locale)}</h3>
                      <p class="project-summary project-quiet-summary">{t(project.summary, locale)}</p>
                      
                      <div class="project-footer">
                        <div class="project-chips">
                          {project.tags.map((tag) => (
                            <Chip tag={tag} locale={locale} />
                          ))}
                        </div>

                        {related.length > 0 && (
                          <div class="project-related">
                            <span class="related-label">{relatedPubsLabel}:</span>
                            <ul class="related-list">
                              {related.map((pub) => {
                                const pubShort = pub.venue.split('–')[0].split('@')[0].trim();
                                return (
                                  <li>
                                    <a href={`${pubsHref}#${pub.id}`} class="related-link" title={pub.title}>
                                      {pubShort} ({pub.year})
                                    </a>
                                  </li>
                                );
                              })}
                            </ul>
                          </div>
                        )}
                      </div>
                    </div>

                    {isMusic && (
                      <div class="conductor-canvas-wrap" aria-hidden="true">
                        <canvas id="conductor-canvas" class="conductor-canvas" width="220" height="96"></canvas>
                      </div>
                    )}
                  </div>
                </article>
              );
            })}
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .featured-list {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .project-entry {
    padding-bottom: 3.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .project-meta {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    color: var(--muted);
    margin-bottom: 0.75rem;
  }

  .project-period {
    color: var(--ink);
    letter-spacing: 0.02em;
  }

  .meta-sep {
    color: var(--rule);
  }

  .project-role {
    color: var(--lane-research);
  }

  .project-title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2vw, 1.85rem);
    font-weight: 400;
    line-height: 1.25;
    color: var(--ink);
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }

  .project-summary {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.65;
    color: var(--ink);
    max-width: var(--col-reading);
    margin-bottom: 1.5rem;
  }

  .project-footer {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .project-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .project-related {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
  }

  .related-label {
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .related-list {
    list-style: none;
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    margin: 0;
    padding: 0;
  }

  .related-link {
    color: var(--muted);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 3px;
    transition: color var(--transition-fast), text-decoration-color var(--transition-fast);
  }

  .related-link:hover {
    color: var(--ink);
    text-decoration-color: var(--ink);
  }

  /* Quiet non-featured row */
  .other-projects {
    margin-top: 3.5rem;
  }

  .project-quiet {
    border-bottom: none;
    padding-bottom: 0;
  }

  .project-quiet-title {
    font-size: 1.25rem;
    color: var(--muted);
  }

  .project-quiet-summary {
    color: var(--muted);
    font-size: 0.98rem;
  }

  /* Conductor particle canvas */
  .music-row-wrap {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
  }

  .conductor-canvas-wrap {
    flex-shrink: 0;
    width: 220px;
    height: 96px;
    border: 1px solid var(--rule);
    border-radius: 2px;
    background: transparent;
    overflow: hidden;
  }

  .conductor-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (max-width: 640px) {
    .music-row-wrap {
      flex-direction: column;
    }

    .conductor-canvas-wrap {
      width: 100%;
      max-width: 280px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .conductor-canvas-wrap {
      display: none;
    }
  }
</style>

<script>
  function initConductor() {
    const canvas = document.getElementById('conductor-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      canvas.style.display = 'none';
      return;
    }

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const width = canvas.width;
    const height = canvas.height;

    const NUM_PARTICLES = 16;
    interface Particle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      baseX: number;
      baseY: number;
      phase: number;
      size: number;
      alpha: number;
    }

    const particles: Particle[] = [];
    for (let i = 0; i < NUM_PARTICLES; i++) {
      const bx = 24 + Math.random() * (width - 48);
      const by = 16 + Math.random() * (height - 32);
      particles.push({
        x: bx,
        y: by,
        vx: 0,
        vy: 0,
        baseX: bx,
        baseY: by,
        phase: Math.random() * Math.PI * 2,
        size: 1.2 + Math.random() * 1.3,
        alpha: 0.35 + Math.random() * 0.45,
      });
    }

    let targetX = width / 2;
    let targetY = height / 2;
    let isHovered = false;
    let isRunning = false;
    let rafId: number | null = null;

    const container = canvas.closest('.project-entry') || canvas;

    container.addEventListener('mousemove', (e: Event) => {
      const mouse = e as MouseEvent;
      const rect = canvas.getBoundingClientRect();
      targetX = mouse.clientX - rect.left;
      targetY = mouse.clientY - rect.top;
      isHovered = true;
    });

    container.addEventListener('mouseleave', () => {
      isHovered = false;
    });

    let lastTime = 0;
    function render(time: number) {
      if (!isRunning || !ctx) return;
      const dt = Math.min(32, time - (lastTime || time)) / 1000;
      lastTime = time;

      ctx.clearRect(0, 0, width, height);

      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      const color = isDark ? '236, 232, 223' : '27, 26, 23';

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        p.phase += dt * 1.5;

        const ambientX = Math.cos(p.phase) * 6;
        const ambientY = Math.sin(p.phase * 0.8) * 6;

        const destX = p.baseX + ambientX;
        const destY = p.baseY + ambientY;

        if (isHovered) {
          const dx = targetX - p.x;
          const dy = targetY - p.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist > 4) {
            p.vx += (dx / dist) * 110 * dt;
            p.vy += (dy / dist) * 110 * dt;
          }
        } else {
          p.vx += (destX - p.x) * 4 * dt;
          p.vy += (destY - p.y) * 4 * dt;
        }

        p.vx *= 0.90;
        p.vy *= 0.90;
        p.x += p.vx * dt * 30;
        p.y += p.vy * dt * 30;

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${color}, ${p.alpha})`;
        ctx.fill();
      }

      rafId = requestAnimationFrame(render);
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          if (!isRunning) {
            isRunning = true;
            lastTime = 0;
            rafId = requestAnimationFrame(render);
          }
        } else {
          isRunning = false;
          if (rafId) cancelAnimationFrame(rafId);
        }
      });
    }, { threshold: 0.1 });

    observer.observe(canvas);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initConductor);
  } else {
    initConductor();
  }
</script>
