---
import type { Locale } from '../lib/types';
import { loadContent, getUi, isTodo } from '../lib/content';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const content = loadContent();

const email = content.meta.email;
const links = content.meta.links;

// Filter links that are not TODO
const activeLinks = Object.entries(links).filter(([_, url]) => !isTodo(url));

// Build timestamp formatted
const buildDate = new Date();
const intlLocale = locale === 'pt' ? 'pt-BR' : 'en-US';
const formattedBuildDate = new Intl.DateTimeFormat(intlLocale, {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
}).format(buildDate);

// Language switch target
let targetSwitchHref = '/';
if (locale === 'en') {
  targetSwitchHref = currentPath.startsWith('/publications') ? '/pt/publicacoes' : '/pt/';
} else {
  targetSwitchHref = currentPath.startsWith('/pt/publicacoes') ? '/publications' : '/';
}
const switchLangText = getUi('switch_lang', locale);
const contactLabel = getUi('contact', locale);
function formatLinkLabel(key: string): string {
  if (key === 'scholar') return 'Google Scholar';
  if (key === 'github') return 'GitHub';
  if (key === 'linkedin') return 'LinkedIn';
  if (key === 'orcid') return 'ORCID';
  return key.charAt(0).toUpperCase() + key.slice(1);
}
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-top">
      <div class="footer-contact">
        <span class="footer-label">{contactLabel}</span>
        <a href={`mailto:${email}`} class="footer-email">{email}</a>
      </div>

      {activeLinks.length > 0 && (
        <ul class="footer-links">
          {activeLinks.map(([name, url]) => (
            <li>
              <a href={url} target="_blank" rel="noopener noreferrer" class="footer-link">
                {formatLinkLabel(name)}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <div class="footer-bottom">
      <div class="footer-meta">
        <span>© {buildDate.getFullYear()} {content.meta.name}</span>
        <span class="sep">·</span>
        <span class="last-updated">
          {locale === 'pt' ? 'Atualizado em' : 'Updated'} {formattedBuildDate}
        </span>
      </div>

      <div class="footer-lang">
        <a href={targetSwitchHref} class="footer-lang-link">
          {switchLangText}
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--rule);
    padding: 3.5rem 0 2.5rem 0;
    margin-top: auto;
    background-color: var(--paper);
    transition: background-color var(--transition-normal), border-color var(--transition-normal);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .footer-label {
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
  }

  .footer-email {
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 3px;
  }

  .footer-email:hover {
    text-decoration-color: var(--ink);
  }

  .footer-links {
    list-style: none;
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }

  .footer-link {
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-link:hover {
    color: var(--ink);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--rule);
    padding-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    color: var(--muted);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .sep {
    color: var(--rule);
  }

  .footer-lang-link {
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    text-decoration: none;
    padding: 0.15rem 0.35rem;
    border: 1px solid var(--rule);
    border-radius: 2px;
  }

  .footer-lang-link:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
</style>
