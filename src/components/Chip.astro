---
import type { Locale } from '../lib/types';
import { getTagLabel } from '../lib/content';

interface Props {
  tag?: string;
  label?: string;
  locale?: Locale;
  laneColor?: string;
}

const { tag, label, locale = 'en', laneColor } = Astro.props;
const displayLabel = label ?? (tag ? getTagLabel(tag, locale) : '');
---

<span class="annotation-chip">
  {laneColor && <span class="chip-pip" style={`background-color: ${laneColor};`} aria-hidden="true" />}
  <span class="chip-text">{displayLabel}</span>
</span>

<style>
  .annotation-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.45rem;
    border: 1px solid var(--rule);
    border-radius: 2px;
    background: transparent;
    color: var(--muted);
    line-height: 1.3;
    white-space: nowrap;
    vertical-align: middle;
  }

  .chip-pip {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .chip-text {
    display: inline;
  }
</style>
