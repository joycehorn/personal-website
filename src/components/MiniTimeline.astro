---
import type { Locale } from '../lib/types';
import { loadContent } from '../lib/content';
import {
  TIMELINE_START_YEAR,
  TIMELINE_END_YEAR,
  yearToX,
  buildTimelineDataset,
} from '../lib/timeline-math';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = loadContent();
const dataset = buildTimelineDataset(content.timeline, content.publications, locale);
const lanes = content.lanes;

const SVG_WIDTH = 800;
const SVG_HEIGHT = 42;
const LANE_HEIGHT = 5;
const LANE_GAP = 2;

const now = new Date();
const currentYearDecimal = now.getFullYear() + (now.getMonth() + 0.5) / 12;
const nowX = yearToX(currentYearDecimal, SVG_WIDTH);
---

<a href="#timeline" class="mini-timeline-strip" aria-label="Jump to interactive career timeline (2002 to 2027)">
  <div class="mini-timeline-inner">
    <div class="mini-timeline-dates" aria-hidden="true">
      <span>2002</span>
      <span>2027</span>
    </div>

    <svg
      viewBox={`0 0 ${SVG_WIDTH} ${SVG_HEIGHT}`}
      class="mini-timeline-svg"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <!-- Lane background guides -->
      {lanes.map((lane, idx) => {
        const y = 8 + idx * (LANE_HEIGHT + LANE_GAP);
        return (
          <line
            x1="0"
            y1={y + LANE_HEIGHT / 2}
            x2={SVG_WIDTH}
            y2={y + LANE_HEIGHT / 2}
            stroke="var(--rule-subtle)"
            stroke-width="1"
          />
        );
      })}

      <!-- Render compressed lane range bars and dots -->
      {dataset.map((entry) => {
        const laneIndex = lanes.findIndex((l) => l.id === entry.lane);
        if (laneIndex === -1) return null;
        const y = 8 + laneIndex * (LANE_HEIGHT + LANE_GAP);
        const color = `var(--lane-${entry.lane})`;

        if (entry.isRange) {
          const x1 = yearToX(entry.start, SVG_WIDTH);
          const x2 = yearToX(entry.end, SVG_WIDTH);
          const width = Math.max(4, x2 - x1);

          return (
            <g>
              <rect
                x={x1}
                y={y}
                width={width}
                height={LANE_HEIGHT}
                rx={LANE_HEIGHT / 2}
                fill={color}
                opacity="0.85"
              />
              {entry.endExpected && entry.endExpected > entry.end && (
                <line
                  x1={x2}
                  y1={y + LANE_HEIGHT / 2}
                  x2={yearToX(entry.endExpected, SVG_WIDTH)}
                  y2={y + LANE_HEIGHT / 2}
                  stroke={color}
                  stroke-width="2"
                  stroke-dasharray="3,2"
                />
              )}
            </g>
          );
        } else {
          const cx = yearToX(entry.start, SVG_WIDTH);
          return (
            <circle
              cx={cx}
              cy={y + LANE_HEIGHT / 2}
              r="2.5"
              fill={color}
              opacity="0.85"
            />
          );
        }
      })}

      <!-- Current date vertical indicator -->
      <line
        x1={nowX}
        y1="4"
        x2={nowX}
        y2={SVG_HEIGHT - 2}
        stroke="var(--ink)"
        stroke-width="1.5"
        stroke-dasharray="2,2"
      />
    </svg>
  </div>
</a>

<style>
  .mini-timeline-strip {
    display: block;
    margin-top: 2.75rem;
    text-decoration: none;
    cursor: pointer;
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 0.5rem 0.85rem;
    background: transparent;
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
    max-width: var(--col-reading);
  }

  .mini-timeline-strip:hover {
    border-color: var(--ink);
    background-color: var(--rule-subtle);
  }

  .mini-timeline-inner {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mini-timeline-dates {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--muted);
    letter-spacing: 0.05em;
  }

  .mini-timeline-svg {
    display: block;
    width: 100%;
    height: 40px;
  }
</style>
