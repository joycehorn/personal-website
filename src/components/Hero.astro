---
import type { Locale } from '../lib/types';
import { loadContent, t, isTodo } from '../lib/content';
import MiniTimeline from './MiniTimeline.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = loadContent();

const name = content.meta.name;
const headline = t(content.headline, locale);
const now = t(content.now, locale);
const email = content.meta.email;

const links = content.meta.links;
const activeLinks = Object.entries(links).filter(([_, url]) => !isTodo(url));
---

<section class="hero-section" aria-label="Introduction">
  <div class="container">
    <div class="hero-inner">
      <h1 class="hero-name">{name}</h1>
      <p class="hero-headline">{headline}</p>

      <div class="hero-now">
        <span class="now-indicator" aria-hidden="true">■</span>
        <span class="now-text">{now}</span>
      </div>

      <div class="hero-actions">
        <a href={`mailto:${email}`} class="hero-email-link">
          <span class="email-prefix">email:</span> {email}
        </a>

        {activeLinks.length > 0 && (
          <div class="hero-links" aria-label="Profiles">
            {activeLinks.map(([key, url]) => (
              <a href={url} target="_blank" rel="noopener noreferrer" class="hero-sublink">
                {key.charAt(0).toUpperCase() + key.slice(1)} ↗
              </a>
            ))}
          </div>
        )}
      </div>

      <MiniTimeline locale={locale} />
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: clamp(3.5rem, 8vw, 7rem);
    padding-bottom: clamp(3.5rem, 8vw, 6rem);
  }

  .hero-inner {
    max-width: 75ch;
  }

  .hero-name {
    font-family: var(--font-display);
    font-size: clamp(48px, 8vw, 104px);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: var(--ink);
    margin-bottom: 2rem;
  }

  .hero-headline {
    font-family: var(--font-body);
    font-size: clamp(1.2rem, 2.4vw, 1.55rem);
    line-height: 1.45;
    color: var(--ink);
    margin-bottom: 1.75rem;
    max-width: var(--col-reading);
  }

  .hero-now {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    line-height: 1.6;
    color: var(--muted);
    margin-bottom: 2.25rem;
    max-width: var(--col-reading);
  }

  .now-indicator {
    color: var(--lane-research);
    font-size: 0.65rem;
    line-height: 1;
    transform: translateY(-1px);
  }

  .hero-actions {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 1.5rem 2.5rem;
  }

  .hero-email-link {
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 4px;
    letter-spacing: 0.01em;
  }

  .hero-email-link:hover {
    text-decoration-color: var(--ink);
  }

  .email-prefix {
    color: var(--muted);
    text-transform: uppercase;
    font-size: var(--text-mono-sm);
    letter-spacing: 0.05em;
  }

  .hero-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .hero-sublink {
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .hero-sublink:hover {
    color: var(--ink);
  }

  @media (max-width: 640px) {
    .hero-name {
      font-size: clamp(38px, 11vw, 52px);
      margin-bottom: 1.5rem;
    }

    .hero-headline {
      font-size: 1.15rem;
      margin-bottom: 1.25rem;
    }

    .hero-actions {
      gap: 1rem;
    }
  }
</style>
