---
import type { Locale } from '../lib/types';
import { loadContent, t, getUi } from '../lib/content';
import Chip from './Chip.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = loadContent();
const themes = content.research_themes;
const sectionLabel = getUi('nav_research', locale);
---

<section id="research" class="research-section" aria-labelledby="research-label">
  <div class="container">
    <div class="section-grid">
      <div class="section-label" id="research-label">
        {sectionLabel}
      </div>

      <div class="section-content">
        <div class="themes-grid">
          {themes.map((theme, index) => (
            <article class={`theme-cell theme-${theme.id}`} data-index={index}>
              <div class="theme-chip-wrap">
                <Chip tag={theme.tag} locale={locale} />
              </div>
              <h3 class="theme-title">{t(theme.title, locale)}</h3>
              <p class="theme-text">{t(theme.text, locale)}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .themes-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }

  .theme-cell {
    padding: 2.25rem 2.25rem 2.25rem 2rem;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    background: transparent;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .theme-chip-wrap {
    margin-bottom: 1.25rem;
  }

  .theme-title {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 1.8vw, 1.55rem);
    font-weight: 400;
    line-height: 1.25;
    color: var(--ink);
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }

  .theme-text {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--muted);
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .themes-grid {
      grid-template-columns: 1fr;
      border-left: none;
      border-top: none;
    }

    .theme-cell {
      padding: 1.75rem 0;
      border-right: none;
      border-bottom: 1px solid var(--rule);
    }

    .theme-cell:first-child {
      border-top: 1px solid var(--rule);
    }
  }
</style>
