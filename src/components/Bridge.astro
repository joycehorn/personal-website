---
import type { Locale } from '../lib/types';
import { loadContent, t } from '../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = loadContent();
const bridge = content.bridge;
const title = t(bridge.title, locale);
const text = t(bridge.text, locale);
---

<section class="bridge-section" aria-label={title}>
  <div class="container">
    <div class="section-grid">
      <div class="section-label bridge-label">
        <span class="bridge-pip" aria-hidden="true" />
        <span>Industry / Pesquisa</span>
      </div>

      <div class="section-content">
        <div class="bridge-block reading-column">
          <h2 class="bridge-title">{title}</h2>
          <p class="bridge-text">{text}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .bridge-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--lane-industry);
  }

  .bridge-pip {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--lane-industry);
    flex-shrink: 0;
  }

  .bridge-block {
    border-left: 2px solid var(--lane-industry);
    padding-left: 1.75rem;
  }

  .bridge-title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.2vw, 1.85rem);
    font-weight: 400;
    line-height: 1.25;
    color: var(--ink);
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }

  .bridge-text {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.65;
    color: var(--ink);
    margin-bottom: 0;
  }
</style>
